{
  "WFWorkflowClientVersion": "2600.0",
  "WFWorkflowMinimumClientVersion": "900",
  "WFWorkflowIcon": {
    "WFWorkflowIconStartColor": 4282601983,
    "WFWorkflowIconGlyphNumber": 59511
  },
  "WFWorkflowActions": [
    {
      "WFWorkflowActionIdentifier": "is.workflow.actions.choosefrommenu",
      "WFWorkflowActionParameters": {
        "prompt": "WidgetUSE [by @lowpaste] ",
        "menuOptions": [
          "widgets"
        ],
        "CustomTitle": "Выбрать из меню",
        "WFMenuPrompt": "WidgetUSE [by @lowpaste] ",
        "WFMenuItems": [
          "widgets"
        ]
      }
    },
    {
      "WFWorkflowActionIdentifier": "is.workflow.actions.openurl",
      "WFWorkflowActionParameters": {
        "url": "https://widgetuse.github.io/scriptable-download",
        "CustomTitle": "Открыть URL / Сайт"
      }
    },
    {
      "WFWorkflowActionIdentifier": "is.workflow.actions.downloadurl",
      "WFWorkflowActionParameters": {
        "url": "widgetuse.github.io/widgets",
        "method": "GET",
        "headers": "{}",
        "CustomTitle": "Получить содержимое URL"
      }
    },
    {
      "WFWorkflowActionIdentifier": "is.workflow.actions.showresult",
      "WFWorkflowActionParameters": {
        "text": "Результат выполнения команды появится здесь",
        "CustomTitle": "widgets",
        "Text": "Результат выполнения команды появится здесь"
      }
    }
  ]
}